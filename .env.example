# Nomadenstuff E-Commerce Environment Configuration Template
# Copy this file to .env and adjust your local settings

ENVIRONMENT=development
BASE_URL=http://localhost/nomadenstuff/

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=nomadenstuff

# RajaOngkir API Configuration
RAJAONGKIR_API_KEY=YOUR_RAJAONGKIR_API_KEY_HERE
RAJAONGKIR_ACCOUNT_TYPE=starter

# Application Security Encryption Key (32 chars)
ENCRYPTION_KEY=YOUR_32_CHARACTER_ENCRYPTION_KEY
